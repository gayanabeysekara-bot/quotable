# ---- ZoneGuard AI example configuration (NO real secrets) ----
# Copy to .env and fill in. Never commit .env.

# development | production
ZG_ENVIRONMENT=development
ZG_DATABASE_URL=postgresql+psycopg://zoneguard:change-me@localhost:5432/zoneguard
POSTGRES_PASSWORD=change-me

# Comma-separated Fernet keys; FIRST encrypts, ALL decrypt (rotation). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZG_ENCRYPTION_KEYS=

# Public URL of the dashboard (used in alert/invite emails)
ZG_PUBLIC_BASE_URL=http://localhost:3000
# Must be true behind HTTPS (required in production)
ZG_COOKIE_SECURE=false
ZG_TRUSTED_PROXY_COUNT=0

ZG_STORAGE_DIR=./data/uploads
ZG_MODEL_DIR=../models
ZG_DEFAULT_PERSON_MODEL=yolox_tiny
ZG_MAX_UPLOAD_MB=500
ZG_MAX_VIDEO_DURATION_S=1800

# Email: smtp | console | memory. Local dev uses Mailpit (docker compose) on port 1025.
ZG_EMAIL_BACKEND=smtp
ZG_SMTP_HOST=localhost
ZG_SMTP_PORT=1025
ZG_SMTP_USERNAME=
ZG_SMTP_PASSWORD=
ZG_SMTP_STARTTLS=false
ZG_SMTP_USE_SSL=false
ZG_EMAIL_FROM=ZoneGuard AI <alerts@example.com>

# ---- Edge agent (runs on the customer's network) ----
ZG_EDGE_API_URL=https://zoneguard.example.com
ZG_EDGE_TOKEN=
ZG_EDGE_PERSON_MODEL=yolox_tiny
ZG_EDGE_SAMPLE_FPS=5
# Only for local development against http://localhost:
ZG_EDGE_ALLOW_INSECURE_HTTP=false
